<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <!-- Per-project intermediates. One shared obj/ was fine when src held a single project;
             with a product per agent, two builds generate conflicting AssemblyInfo into the same
             directory and the solution build fails with duplicate-attribute errors. Each product
             sets its own BaseOutputPath, so only the intermediate path needs a default here. -->
        <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\</BaseIntermediateOutputPath>
    </PropertyGroup>

    <!-- A shipped binary must not name the machine it was built on. The compiler records the PDB
         path exactly as it was given, so a Release DLL carried
         /Users/<author>/.../obj/Release/ClaudeConsolePlugin.pdb — the author's username and folder
         layout, readable by anyone running `strings` on the plugin (#26).

         PathMap rewrites those recorded paths without dropping the symbols: DebugType=none would
         also remove the leak, but it would strip line numbers from every stack trace in the plugin
         log, and those traces are how field crashes get diagnosed. Deterministic + PathMap is also
         what makes two builds of the same source produce identical bytes, which is how a "did this
         package actually get rebuilt?" question gets answered.
         Debug builds keep real paths so a debugger can still find the sources. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
        <Deterministic>true</Deterministic>
    </PropertyGroup>
</Project>
