<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A console app, deliberately: the spike proved FreeConsole() + AttachConsole(target) works
      from one, and the plugin launches it with CreateNoWindow so no window ever appears. A WinExe
      would make `selftest` unable to print, which is the one mode a human runs by hand.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>claude-console-inject</AssemblyName>
    <RootNamespace>ClaudeConsoleInject</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Ships inside the plugin package, beside the plugin DLL. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!--
      Self-contained AND trimmed, deliberately: LogiPluginService carries its own PRIVATE .NET
      runtime (coreclr.dll in its install dir — verified on hardware 2026-08-07), so a machine
      running Options+ does NOT necessarily have a machine-wide .NET for a framework-dependent
      helper to find; on one without it, typing would silently die. Trimming keeps the cost
      sane: ~12 MB per helper instead of the 137 MB an untrimmed self-contained publish cost
      when this was first tried. (NativeAOT would be ~3 MB and faster still, but needs the MSVC
      linker at build time — revisit if the build machines get the C++ workload.)
    -->
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

</Project>
