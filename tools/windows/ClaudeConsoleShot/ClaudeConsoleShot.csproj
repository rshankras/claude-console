<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A console app like the other helpers: a human can run `claude-console-shot out.png` by
      hand to debug a capture that never lands.
    -->
    <OutputType>Exe</OutputType>
    <!-- The helper carries the Desktop Runtime, including native libraries: Options+ does not
         install a globally discoverable runtime. WPF/WinForms must remain untrimmed. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>claude-console-shot</AssemblyName>
    <RootNamespace>ClaudeConsoleShot</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Ships inside the plugin package, beside the plugin DLL. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
