<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A console app like the other helpers: a human can run `claude-console-shot out.png` by
      hand to debug a capture that never lands.
    -->
    <OutputType>Exe</OutputType>
    <!-- net8.0-windows for the platform analyser, but NO UseWindowsForms: the clipboard is read
         through Win32, and the PNG is the overlay's own or comes from GDI+ through the
         System.Drawing.Common package, so the Desktop Runtime is not needed. It once was (the
         WinForms Clipboard class), which made this exe either framework-dependent and broken on
         clean machines (#83) or self-contained and 68 MB. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>claude-console-shot</AssemblyName>
    <RootNamespace>ClaudeConsoleShot</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Ships inside the plugin package, beside the plugin DLL. Self-contained and trimmed like
         the inject and hook helpers: the Plugin Service carries a PRIVATE runtime, so no
         machine-wide .NET can be assumed. Partial trimming keeps this assembly and the drawing
         package whole and trims only the framework, which is where the size is. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

</Project>
